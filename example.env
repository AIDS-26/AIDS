CODEX_API_KEY = ''
# Export CODEX_API_KEY in the process environment for model tuning; no key is logged.
# The tuning adapter does not load API credentials from .env.
# CODEX_MODEL=<explicit Responses API model supporting Structured Outputs>

# Backend workers only; the SIEM frontend will use the backend API.
# Relative paths use this repository root.
# DATABASE_PATH can also be set in the process environment (takes precedence).
DATABASE_PATH=data/aids.sqlite3

# Evaluation labels only. Default if omitted: <database stem>.labels.sqlite3.
# Keep outside runtime-tool workspaces when access isolation is needed.
# LABEL_DATABASE_PATH=data/aids.labels.sqlite3
